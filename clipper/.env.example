# Copy this file to .env (same folder) and fill in your keys.
# .env is git-ignored, so your keys never get pushed.

# Required: Claude (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Optional: Higgsfield AI intros (console.higgsfield.ai)
HF_API_KEY_ID=
HF_API_KEY_SECRET=
